---
import Logo from '../components/Logo.astro';
import '../styles/global.css';
import {
  SITE_URL,
  DOMAIN,
  LAST_UPDATED,
  ATTRACTION,
  NEARBY_LANDMARKS,
  SOURCES,
  GOVT_TOURISM_URL,
  GOVT_CITY_URL,
  NATIONAL_MUSEUM_URL,
} from '../config';

const canonical = `${SITE_URL}/`;
const heroImage = '/images/freedom-square-tbilisi-hero.jpg';
const nightImage = '/images/freedom-square-tbilisi-night.jpg';
const ogImage = `${SITE_URL}${heroImage}`;

const title = 'თავისუფლების მოედანი (Freedom Square, თბილისი) — Visitor Guide & Location';
const ogTitle = 'თავისუფლების მოედანი (Freedom Square) — თბილისის გზამკვლევი';
const description =
  'თავისუფლების მოედანი (Freedom Square / Liberty Square) — თბილისის ცენტრალური მოედანი საქართველოში. რუკა, მისვლა მეტროთი, ახლომდებარე ღირსშესანიშნაობები, ისტორია და ვიზიტის რჩევები.';
const ogDescription = `ოფიციალური ვიზიტორთა გზამკვლევი თავისუფლების მოედანზე (Freedom Square) — თბილისი, საქართველო. მდებარეობა, რუკა, მისვლა და ახლომდებარე ღირსშესანიშნაობები.`;
const ogImageAlt = 'თავისუფლების მოედანი (Freedom Square) თბილისში, საქართველო';
const heroImgAlt = 'თავისუფლების მოედანი (Freedom Square) — მთავარი ხედი თბილისში, საქართველო';
const nightImgAlt = 'თავისუფლების მოედანი (Freedom Square) ღამით — წმინდა გიორგის მონუმენტი, თბილისი';
const lastUpdatedLabel = '2026 წლის 10 სექტემბერი';

const mapUrl = ATTRACTION.mapsShareUrl;
const mapEmbed = ATTRACTION.mapsEmbedSrc;

const breadcrumbItems = [
  { name: 'მთავარი', url: `${SITE_URL}/` },
  { name: 'თბილისი', url: `${SITE_URL}/#about` },
  { name: 'საქართველო', url: `${SITE_URL}/#about` },
  { name: `${ATTRACTION.name} (${ATTRACTION.nameEn})`, url: `${SITE_URL}/` },
];

const attractionSchema = {
  '@type': 'TouristAttraction',
  '@id': `${SITE_URL}/#attraction`,
  name: ATTRACTION.name,
  alternateName: ATTRACTION.alternateNames,
  description: `Comprehensive visitor guide to ${ATTRACTION.nameEn} (${ATTRACTION.name}) in ${ATTRACTION.cityEn}, ${ATTRACTION.countryEn}.`,
  url: `${SITE_URL}/`,
  image: [`${SITE_URL}${heroImage}`, `${SITE_URL}${nightImage}`],
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ATTRACTION.streetAddress,
    addressLocality: ATTRACTION.cityEn,
    addressRegion: ATTRACTION.region,
    addressCountry: ATTRACTION.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: ATTRACTION.latitude,
    longitude: ATTRACTION.longitude,
  },
  hasMap: ATTRACTION.mapsShareUrl,
  sameAs: [
    ATTRACTION.mapsShareUrl,
    GOVT_TOURISM_URL,
    GOVT_CITY_URL,
    'https://en.wikipedia.org/wiki/Freedom_Square,_Tbilisi',
  ],
  touristType: ['City explorers', 'History enthusiasts', 'Photographers'],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: ATTRACTION.openingHours.opens,
      closes: ATTRACTION.openingHours.closes,
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: ATTRACTION.rating,
    ratingCount: ATTRACTION.reviewCount,
    bestRating: 5,
  },
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'თავისუფლების მოედანი — დამოუკიდებელი გზამკვლევი',
      url: `${SITE_URL}/`,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/icon-512.png` },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'თავისუფლების მოედანი (Freedom Square) — თბილისი',
      inLanguage: 'ka',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}/#webpage`,
      url: `${SITE_URL}/`,
      name: title,
      description,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#attraction` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
      datePublished: LAST_UPDATED,
      dateModified: LAST_UPDATED,
      inLanguage: 'ka',
    },
    attractionSchema,
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE_URL}/#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    },
  ],
};

const faq = [
  ['სად მდებარეობს თავისუფლების მოედანი?', 'თავისუფლების მოედანი (Freedom Square) მდებარეობს თბილისის ცენტრში, საქართველოში, მისამართზე 2 Freedom Square (Plus Code MRV2+8J). ის რუსთაველის გამზირს, სოლოლაკსა და ძველ თბილისს აკავშირებს.'],
  ['თავისუფლების მოედანზე შესვლა ფასიანია?', 'არა. ეს საჯარო ქალაქის მოედანია და შესასვლელი ბილეთი არ არის საჭირო. ახლომდებარე მუზეუმებსა და სხვა ობიექტებს შეიძლება საკუთარი საფასური ჰქონდეთ.'],
  ['რამდენი დრო დავუთმო მოედანს?', 'მხოლოდ მოედნის სანახავად დაახლოებით 20–40 წუთი საკმარისია. თუ ძველ თბილისს, სოლოლაკს ან რუსთაველის გამზირსაც აერთიანებთ, დაგეგმეთ უფრო გრძელი სასეირნო მარშრუტი.'],
  ['რომელია საუკეთესო დრო ფოტოების გადასაღებად?', 'ადრეული დილა უფრო მშვიდი და ნაკლებად ხალხმრავალია. საღამოს კი მოედანი განათებულია და ოქროსფერი წმინდა გიორგის მონუმენტი განსაკუთრებით ეფექტურად ჩანს.'],
  ['როგორ მივიდე საზოგადოებრივი ტრანსპორტით?', 'ყველაზე მარტივი არჩევანია მეტროს სადგური „თავისუფლების მოედანი“. ავტობუსის მარშრუტები შეიძლება შეიცვალოს, ამიტომ მგზავრობამდე გამოიყენეთ თბილისის სატრანსპორტო კომპანიის მიმდინარე მარშრუტების დაგეგმვა.'],
  ['სად შეიძლება მანქანის გაჩერება?', 'ქალაქის ცენტრში ქუჩის ადგილი შეზღუდულია. მოედანთან მდებარე Galleria Tbilisi-ს აქვს ფასიანი მიწისქვეშა პარკინგი; მიმდინარე ტარიფი და პირობები ადგილზე გადაამოწმეთ.'],
  ['მოედანი ღამითაც ხელმისაწვდომია?', 'როგორც ღია საჯარო სივრცე, მოედანი დღე-ღამის განმავლობაში ხელმისაწვდომია. გვიან საათებში ჩვეულებრივი ქალაქური სიფრთხილე დაიცავით.'],
  ['რომელი ღირსშესანიშნაობებია მოედნის ახლოს?', 'მოედნიდან ფეხით მისაღებია ალექსანდრე პუშკინის სკვერი, რუსთაველის გამზირი, საქართველოს ეროვნული მუზეუმი, კოტე აფხაზის ქუჩა და ძველი თბილისი, ასევე მშვიდობის ხიდი და სიონის ტაძარი.'],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---
<!doctype html>
<html lang="ka">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="თავისუფლების მოედანი — დამოუკიდებელი გზამკვლევი" />
    <meta name="theme-color" content="#111b27" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ka" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="თავისუფლების მოედანი (Freedom Square)" />
    <meta property="og:locale" content="ka_GE" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="848" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Google Analytics 4 — იტვირთება მხოლოდ მომხმარებლის თანხმობის შემდეგ -->
    <script is:inline>
      (function () {
        var KEY = 'freedomsquaretbilisi-consent';
        var loaded = false;
        function load() {
          if (loaded || window.__gaLoaded) return;
          loaded = true;
          window.__gaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
        }
        try {
          if (localStorage.getItem(KEY) === 'granted') load();
        } catch (e) {}
        window.addEventListener('consent-updated', function (e) {
          if (e && e.detail && e.detail.analytics) load();
        });
      })();
    </script>
  </head>
  <body>
    <div class="site-shell" id="top">
      <header class="header">
        <div class="container header-row">
          <Logo />
          <nav class="nav" aria-label="მთავარი ნავიგაცია">
            <a href="#about">მიმოხილვა</a>
            <a href="#story">ისტორია</a>
            <a href="#visit">ვიზიტი</a>
            <a href="#transport">ტრანსპორტი</a>
            <a href="#nearby">ახლომახლო</a>
            <a href="#map">რუკა</a>
            <a href="#sources">წყაროები</a>
          </nav>
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-media">
            <img src={heroImage} alt={heroImgAlt} width="1280" height="848" {...{ fetchpriority: 'high' }} />
          </div>
          <div class="hero-ring r1"></div><div class="hero-ring r2"></div>
          <div class="container hero-content">
            <div class="hero-grid">
              <div>
                <span class="eyebrow">თბილისის ისტორიული ცენტრი</span>
                <h1 id="hero-title">თავისუფლების მოედანი <span class="h1-sub">(Freedom Square · თბილისი)</span></h1>
                <p class="hero-sub">ქალაქის წერტილი, სადაც რუსთაველის გამზირი, სოლოლაკი და ძველი თბილისი ერთმანეთს ხვდება — ოქროსფერი წმინდა გიორგის მონუმენტის გარშემო.</p>
                <div class="hero-actions">
                  <a class="btn btn-primary" href="#visit">ვიზიტის დაგეგმვა</a>
                  <a class="btn btn-ghost" href={mapUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>
                </div>
              </div>
              <div class="hero-facts" aria-label="მოკლე ინფორმაცია">
                <div class="hero-fact"><strong>4.7 / 5</strong><span>17 408 Google შეფასება</span></div>
                <div class="hero-fact"><strong>უფასო</strong><span>საჯარო მოედანი · ბილეთი არ არის</span></div>
                <div class="hero-fact"><strong>24 საათი</strong><span>ღია ურბანული სივრცე</span></div>
                <div class="hero-fact"><strong>MRV2+8J</strong><span>თბილისი, საქართველო</span></div>
              </div>
            </div>
          </div>
          <div class="photo-credit">ფოტო: <a href="https://commons.wikimedia.org/wiki/File:Freedom_Square,_Tbilisi.jpg" target="_blank" rel="noopener noreferrer">anjči / Wikimedia Commons · CC BY 2.0</a></div>
        </section>

        <section class="section about" id="about">
          <div class="container">
            <nav class="breadcrumb" aria-label="ნავიგაციის ბილიკი">
              <a href="/">მთავარი</a>
              <span aria-hidden="true">›</span>
              <span>თბილისი</span>
              <span aria-hidden="true">›</span>
              <span>საქართველო</span>
              <span aria-hidden="true">›</span>
              <span class="current">{ATTRACTION.name} (Freedom Square)</span>
            </nav>
            <span class="eyebrow section-kicker">მიმოხილვა</span>
            <h2 class="section-title">თავისუფლების მოედანი (Freedom Square) — მოკლე მიმოხილვა.</h2>
            <p class="about-intro">
              კეთილი იყოს თქვენი მობრძანება <strong>თავისუფლების მოედანზე</strong>, რომელიც ფართოდ არის ცნობილი როგორც ცენტრალური <strong>Freedom Square</strong> (ასევე <strong>Liberty Square</strong>). მოედანი მდებარეობს <strong>თბილისის</strong> გულში, <strong>საქართველოში</strong>, და წარმოადგენს რეგიონის მთავარ სატრანსპორტო და ტურისტულ კვანძს — აქედან იწყება ქალაქის ცენტრის ფეხით შესწავლა.
            </p>
            <p class="about-cluster">
              მოედნის მონახულებისას ადვილად შეგიძლიათ იხილოთ ახლომდებარე ისტორიული ღირსშესანიშნაობები, მათ შორის <strong>ალექსანდრე პუშკინის სკვერი</strong> და <strong>რუსთაველის გამზირი</strong>, ასევე ძველი თბილისის ქუჩები მშვიდობის ხიდამდე.
            </p>
            <ul class="landmark-chips" aria-label="ახლომდებარე ღირსშესანიშნაობები">
              {NEARBY_LANDMARKS.map((landmark) => (
                <li>{landmark.name} <span>{landmark.distance}</span></li>
              ))}
            </ul>
            <div class="fact-table" role="table" aria-label="მოედნის ძირითადი მონაცემები">
              <div class="fact-row" role="row"><span role="cell">ოფიციალური სახელი</span><b role="cell">თავისუფლების მოედანი (Freedom Square)</b></div>
              <div class="fact-row" role="row"><span role="cell">მისამართი</span><b role="cell">2 Freedom Square, თბილისი, საქართველო</b></div>
              <div class="fact-row" role="row"><span role="cell">Plus Code</span><b role="cell">MRV2+8J</b></div>
              <div class="fact-row" role="row"><span role="cell">კოორდინატები</span><b role="cell">41.6939923° N, 44.7982501° E</b></div>
              <div class="fact-row" role="row"><span role="cell">Google შეფასება</span><b role="cell">4.7 / 5 · 17 408 შეფასება</b></div>
              <div class="fact-row" role="row"><span role="cell">სამუშაო საათები</span><b role="cell">24 საათი · ღია საჯარო სივრცე</b></div>
